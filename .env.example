# Eidos environment variables
# Copy this file to ".env" and fill in your values.

# ── Supabase (pre-provisioned) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── TMDB API ────────────────────────────────────────────────
# Get your key at https://www.themoviedb.org/settings/api
# Provide EITHER the v3 API key OR the v4 read access token.
# The v4 read access token (Bearer auth) is recommended.
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=
